rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // users/{uid}: the player's profile, settings and limits.
    match /users/{uid} {
      allow read: if isOwner(uid);

      // First sign in creates the profile. Status and age gate start locked.
      allow create: if isOwner(uid)
        && request.resource.data.status == 'active'
        && request.resource.data.ageConfirmed == false;

      // The player may change only these fields. status is server only.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoUrl', 'ageConfirmed', 'settings', 'limits', 'lastLoginAt']);

      allow delete: if false;

      // Wallet: the app may create it once with the starting credits.
      // After that only the game server (Admin SDK) can change it.
      match /wallet/{doc} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && doc == 'current' && request.resource.data.balance == 10000;
        allow update, delete: if false;
      }

      // Round history written by the game server. The player can read it.
      match /rounds/{roundId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Public fairness commitment (seed hash, client seed, nonce) and revealed seeds.
      // The live server seed itself lives in fair_secrets/{uid}, which no client can read.
      match /fairness/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /seed_history/{hash} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Account standing: bans, suspensions, restrictions, investigations and appeals.
      // The app listens to account/standing, so a staff action shows up live.
      // Only the game server (Admin SDK) writes any of this.
      match /account/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /standing_actions/{id} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /appeals/{id} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Support: the player reads their own tickets and messages live.
      // Tickets are created and answered through the game server only.
      // Internal notes live in tickets/{id}/notes, which no client can read.
      match /tickets/{ticketId} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // Progress: same idea, starts at level 1.
      match /progress/{doc} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && doc == 'current'
          && request.resource.data.level == 1 && request.resource.data.xp == 0;
        allow update, delete: if false;
      }
    }

    // Server-owned catalog and remote config. Signed-in players can read, nobody writes.
    match /games/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // crash_rounds/* holds secret crash points. No client access, ever.
    // (The final rule below already denies it; the server uses the Admin SDK.)

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
