# Copy to .env.local (never commit it). Create the three CONSOLE_* values with:  python manage.py setup
CONSOLE_USER=
CONSOLE_PASSWORD_HASH=
CONSOLE_TOTP_SECRET=

# One DEV_API_SECRET per game server. Make it with:  python manage.py gen-secret
# The SAME value goes on that server as DEV_API_SECRET. targets.json names which variable belongs to which server.
PROD_DEV_API_SECRET=
LOCAL_DEV_API_SECRET=UqLkACW_18rrCf8XWk1dyiZK_s9pxY7Zqh996r2r054MTKkTF_O7OBGv9IWwUEMF

# Local http only. Behind HTTPS leave this out (cookies are then Secure).
COOKIE_SECURE=0

# Optional hardening and alerts
# CONSOLE_ALLOWED_IPS=203.0.113.7,198.51.100.4   only these addresses can even see the console
# TRUST_PROXY=1                                   1 on Cloud Run (so the real client address is used)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/...   Slack / Discord / any URL that accepts {"text": "..."}
# TELEGRAM_BOT_TOKEN=  TELEGRAM_CHAT_ID=
# SERVER_DIR=../server                            where "Run the server test suite" runs pytest
# PROBE_SECONDS=30
