[
  {
    "id": "server-tests",
    "label": "Run the server test suite",
    "description": "Runs pytest in your server folder (SERVER_DIR). Needs the dev requirements installed there.",
    "argv": [
      "python3",
      "-m",
      "pytest",
      "-q",
      "tests"
    ],
    "cwd": "$SERVER_DIR",
    "timeout": 600,
    "confirm": "RUN"
  },
  {
    "id": "backup-firestore",
    "label": "Back up Firestore to a bucket",
    "description": "Exports the whole database to gs://BUCKET/backups/NAME. Run this before a risky migration.",
    "argv": [
      "gcloud",
      "firestore",
      "export",
      "gs://{bucket}/backups/{name}",
      "--project",
      "{project}"
    ],
    "params": {
      "bucket": {
        "label": "Cloud Storage bucket",
        "pattern": "[a-z0-9][a-z0-9._-]{2,62}"
      },
      "name": {
        "label": "Backup name",
        "pattern": "[A-Za-z0-9_-]{3,40}"
      },
      "project": {
        "label": "Firebase project id",
        "pattern": "[a-z][a-z0-9-]{4,29}",
        "default": "rev-games"
      }
    },
    "timeout": 1800,
    "confirm": "BACKUP"
  },
  {
    "id": "deploy-cloud-run",
    "label": "Deploy the server to Cloud Run",
    "description": "Saves buffered counters, deploys the folder, then runs the smoke tests. Players keep playing during a normal deploy; tick maintenance first for a risky change.",
    "argv": [
      "gcloud",
      "run",
      "deploy",
      "{service}",
      "--source",
      ".",
      "--region",
      "{region}",
      "--project",
      "{project}",
      "--quiet"
    ],
    "cwd": "$SERVER_DIR",
    "params": {
      "service": {
        "label": "Cloud Run service",
        "pattern": "[a-z][a-z0-9-]{1,62}",
        "default": "rev-games-server"
      },
      "region": {
        "label": "Region",
        "pattern": "[a-z]+-[a-z]+[0-9]",
        "default": "europe-west1"
      },
      "project": {
        "label": "Project id",
        "pattern": "[a-z][a-z0-9-]{4,29}",
        "default": "rev-games"
      }
    },
    "pre": [
      "flush"
    ],
    "post": [
      "smoke"
    ],
    "timeout": 1800,
    "danger": true,
    "confirm": "DEPLOY"
  },
  {
    "id": "rollback-cloud-run",
    "label": "Roll back to a previous revision",
    "description": "Sends 100% of traffic to a revision you name (see Cloud Run > Revisions).",
    "argv": [
      "gcloud",
      "run",
      "services",
      "update-traffic",
      "{service}",
      "--to-revisions",
      "{revision}=100",
      "--region",
      "{region}",
      "--project",
      "{project}"
    ],
    "params": {
      "service": {
        "label": "Cloud Run service",
        "pattern": "[a-z][a-z0-9-]{1,62}",
        "default": "rev-games-server"
      },
      "revision": {
        "label": "Revision name",
        "pattern": "[a-z][a-z0-9-]{1,100}"
      },
      "region": {
        "label": "Region",
        "pattern": "[a-z]+-[a-z]+[0-9]",
        "default": "europe-west1"
      },
      "project": {
        "label": "Project id",
        "pattern": "[a-z][a-z0-9-]{4,29}",
        "default": "rev-games"
      }
    },
    "post": [
      "smoke"
    ],
    "danger": true,
    "confirm": "ROLLBACK"
  },
  {
    "id": "move-to-region",
    "label": "Migrate the server to another region or project",
    "description": "Deploys the same code as a NEW service in the region/project you choose. Then point the app's API URL at it and switch DNS. The old service stays up until you delete it.",
    "argv": [
      "gcloud",
      "run",
      "deploy",
      "{service}",
      "--source",
      ".",
      "--region",
      "{region}",
      "--project",
      "{project}",
      "--quiet"
    ],
    "cwd": "$SERVER_DIR",
    "params": {
      "service": {
        "label": "New service name",
        "pattern": "[a-z][a-z0-9-]{1,62}"
      },
      "region": {
        "label": "New region",
        "pattern": "[a-z]+-[a-z]+[0-9]"
      },
      "project": {
        "label": "Project id",
        "pattern": "[a-z][a-z0-9-]{4,29}"
      }
    },
    "pre": [
      "flush"
    ],
    "timeout": 1800,
    "danger": true,
    "confirm": "MIGRATE"
  }
]
