# ---------------------------------------------------------------------------
# REV Games server settings. COPY this file, never put real secrets in it.
#
#   .env.example              (committed)  every setting, documented
#   .env.local.example        (committed)  template for your laptop
#   .env.production.example   (committed)  template for Cloud Run
#   .env.local / .env.production / .env    YOUR copies. Git ignores them.
#
# Which file is read is decided by APP_ENV (default "local"):
#   APP_ENV=local       -> .env.local, then .env
#   APP_ENV=production  -> .env.production, then .env
# Variables already set in the shell or on Cloud Run always win over files.
# ---------------------------------------------------------------------------

APP_ENV=local

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1            # 0.0.0.0 to reach it from a phone on your wifi
PORT=8080

# --- Firebase ----------------------------------------------------------------
FIREBASE_PROJECT_ID=rev-games
# Local only: path to the service account JSON (absolute, ~/..., or relative to server/).
# On Cloud Run leave this OUT: the service account is attached to the service.
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/keys/rev-games-admin.json

# --- Staff sign-in (/staff) ----------------------------------------------------
# One page for everyone. The admin goes to /admin, support reps go to /support.
#
# The ADMIN account lives here, never in the database. Rules:
#   username  6+ chars, lowercase letters/numbers/. _ -   (NOT "admin" or "rev-admin")
#   password  12+ chars with upper, lower, number and symbol
# Prefer ADMIN_PASSWORD_HASH on a real server: run  python manage.py hash-password
ADMIN_USERNAME=
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# After signing in, the admin must also enter this key to open the dashboard.
# Empty = dashboard off. Make it long and random:  python manage.py gen-secret
ADMIN_KEY=

# Signs staff sessions. Set it so sessions survive restarts and work on every instance.
SESSION_SECRET=
STAFF_SESSION_HOURS=8
LOGIN_MAX_FAILS=5           # wrong passwords before the username is locked...
LOGIN_LOCK_MINUTES=15       # ...for this long

# Customer service reps are created by the admin in the dashboard (Team tab).

# --- Attachments (appeals + support) -------------------------------------------
# Production: a Firebase Storage bucket, e.g. rev-games.firebasestorage.app
# Empty = save files to UPLOAD_DIR (default server/data/uploads). Fine locally, not on Cloud Run.
FIREBASE_STORAGE_BUCKET=
# UPLOAD_DIR=
UPLOAD_MAX_MB=25
UPLOAD_MAX_FILES=5
UPLOAD_DAILY_LIMIT=40
MAX_OPEN_TICKETS=5

# --- Account standing ----------------------------------------------------------
PROBATION_HOURS=72          # after a suspension / restriction / ban ends
PROBATION_MAX_BET=1000      # bet cap while on probation
APPEAL_COOLDOWN_HOURS=24    # wait after a rejected appeal
RISK_WINDOW_DAYS=3          # dashboard "restricted in the past N days"

# --- Game tuning --------------------------------------------------------------------
# Every game has a LIVE (real money) setting and a DEMO (practice credits) setting.
# Names end in _LIVE or _DEMO. The values below are the defaults. Restart the server after changing.
#
# "EDGE" = the share of every bet the house keeps, on average. Harder game = bigger edge.
#   0.05  = house keeps 5% (player gets 95% back).   0 = fair.   -0.15 = player gets 115% back (demo only).

# ----- Dice -----
DICE_EDGE_LIVE=0.05            # real money: 5% edge. Raise it to make Dice harder.
DICE_EDGE_DEMO=-0.15           # practice: negative = the player is favoured, wins feel easy.
DICE_MIN_BET=10
DICE_MAX_BET=100000

# ----- Crash -----
CRASH_EDGE_LIVE=0.05           # real money: 5% edge. Rounds bust earlier when you raise it.
CRASH_EDGE_DEMO=-0.15          # practice: a round never busts below 1.15x.
CRASH_MIN_BET=10
CRASH_MAX_BET=500000
CRASH_GROWTH_RATE=0.12         # how fast the multiplier climbs (looks only, not odds)
CRASH_MAX_MULTIPLIER=5000

# ----- Plinko -----
PLINKO_EDGE_LIVE=0.04          # real money: 4% edge (96% back). Raise it to make Plinko harder.
PLINKO_EDGE_DEMO=-0.60         # practice: below 0 = generous board, only the middle slot loses (about 1 drop in 4-5).
PLINKO_MIN_BET=10
PLINKO_MAX_BET=100000
PLINKO_MAX_PAYOUT=5000000      # one drop can never pay more than this (lowers the max bet on big-multiplier boards)

# ----- Golden Reels (slots) -----
# LUCK = how often wins land compared with the pay table. 1.0 = exactly the table, lower = harder.
SLOTS_LUCK_LIVE=0.85           # real money: about 82% back, roughly 1 spin in 4 wins. Lower = harder. Do not go below ~0.8.
SLOTS_DEMO_GENEROUS=1          # practice: 1 = easy table (777 about 1 spin in 50). 0 = use SLOTS_LUCK_DEMO instead.
SLOTS_LUCK_DEMO=1.5            # only used when SLOTS_DEMO_GENEROUS=0.

# ----- Rounds (play limit and extra rounds) -----
# Every player gets ROUNDS_FREE rounds shared by ALL games. They come back ROUNDS_WINDOW_HOURS after the first
# round of a window. After that a player can buy extra rounds in packs at ROUND_PRICE each (paid from their
# live balance, or from credits in demo). Bought rounds never expire. This pays for database reads and writes.
ROUNDS_LIMIT=1                 # 1 = limit on. 0 = unlimited play (turns the whole thing off).
ROUNDS_FREE_LIVE=14            # free rounds per window, real money wallet
ROUNDS_FREE_DEMO=14            # free rounds per window, demo credits
ROUNDS_WINDOW_HOURS=6          # hours until free rounds refresh
ROUND_PRICE_LIVE=50            # price of one extra round, in LIVE_CURRENCY (NGN)
ROUND_PRICE_DEMO=50            # price of one extra round, in demo credits
ROUND_PACKS=5,10,25,50         # pack sizes players can buy
ROUND_COOLOFF_SECONDS=1        # a player can only run one round at a time and must wait this long between rounds (protects the database). 0 = off.

# ----- Roulette and Blackjack -----
# These use the standard casino rules. The knob below changes what WINNINGS pay (your stake always comes back).
WIN_BOOST_LIVE=0               # real money: 0 = standard payouts. -0.1 = winnings pay 10% less (harder). Never above 0.
WIN_BOOST_DEMO=0.4             # practice: winnings pay 40% extra.
ROULETTE_MIN_BET=10
ROULETTE_MAX_TOTAL=100000      # most a player can stake on one table
ROULETTE_MAX_PAYOUT=1000000    # most one spin can pay, however the chips are spread
BLACKJACK_MIN_BET=10
BLACKJACK_MAX_BET=100000

# ----- Accounts and rewards -----
STARTING_BALANCE=10000         # practice credits a new player starts with
DAILY_COOLDOWN_SECONDS=86400
STREAK_GRACE_SECONDS=172800
XP_BET_DIVISOR=10
DUP_COOLOFF_SECONDS=1.5        # an identical repeat request inside this time is ignored (double taps)

# --- Speed -----------------------------------------------------------------------
# Requests slower than this are logged as warnings (every request logs its time).
SLOW_REQUEST_MS=800
# Seconds the server reuses a player's moderation status between requests.
# A new ban/suspension takes effect within this long. 0 = always check.
STANDING_CACHE_SECONDS=15
# Seconds the game list (GET /v1/games) is reused. Edits in the Firebase console show up within this long.
CATALOG_CACHE_SECONDS=20

# --- Live play (real money) ---------------------------------------------------------
# 1 credit in live mode = 1 unit of LIVE_CURRENCY.
LIVE_ENABLED=1
LIVE_CURRENCY=NGN
# LIVE_MIN_DEPOSIT=500
# LIVE_MAX_DEPOSIT=500000
# LIVE_MIN_PAYOUT=1000
# LIVE_MAX_PAYOUT=1000000
# LIVE_MAX_OPEN_PAYOUTS=3
# --- Live Money Agreement and currency rates ------------------------------------------
LIVE_AGREEMENT_REQUIRED=1      # 1 = players must accept the Live Money Agreement before real-money play
LIVE_AGREEMENT_VERSION=2       # raise it (3, 4...) when the text changes: everyone is asked to accept again
FX_USD=1550                    # wallet units (NGN) per 1 US dollar. Used for PayPal amounts
FX_USDT=1550                   # wallet units (NGN) per 1 USDT. Used for crypto amounts

# "mock" = fake Paystack / Flutterwave / Stripe / Apple Pay / Google Pay for development.
# The fake gateways refuse to run on Cloud Run unless ALLOW_MOCK_PAYMENTS=1.
PAYMENTS_MODE=mock
# Signs webhooks from the (mock) provider. Use each real provider's own secret when you wire them.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# --- Email (founder dashboard -> Insights -> Email) ----------------------------------
# No SMTP_HOST = mock mode: campaigns are recorded but nothing is sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=REV Games <no-reply@yourdomain.com>
# CAMPAIGN_MAX_RECIPIENTS=1000
# ACTIVE_DAYS=30            # "active" = seen within this many days

# --- Developer console link ---------------------------------------------------------
# Turns on /internal/dev/*. Must be 32+ characters; make one with the console's `python manage.py gen-secret`.
# Calls without a valid signature get 401, and nothing works if this is empty.
# DEV_API_SECRET=
# DEV_ALLOWED_IPS=203.0.113.7     optional: only these addresses may call it
# APP_VERSION=1.0.0               shown in the console

# ---- Who runs the service (shown on the "Who we are" page and in the legal texts) ----
# Leave a value empty and that line is simply not shown. Fill these in before launch.
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_REG_NO=
LICENCE_NO=
REGULATOR=
BUSINESS_EMAIL=
BUSINESS_PHONE=
GOVERNING_LAW=
# Public address of this server, used for the unsubscribe link in emails (no trailing slash).
PUBLIC_URL=
